rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function isOwner(roomId) {
      return signedIn() &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
    }

    // 본인 user 문서만
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // 코드→방 역인덱스: 로그인 시 읽기(참여용), 생성은 로그인
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn(); // 방 삭제 시 owner가 정리
    }

    match /rooms/{roomId} {
      allow read: if isMember(roomId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(roomId);

      // 멤버: 본인 가입/탈퇴, owner는 강퇴 가능
      match /members/{uid} {
        allow read: if isMember(roomId);
        allow create: if signedIn() && request.auth.uid == uid;
        allow delete: if request.auth.uid == uid || isOwner(roomId);
        allow update: if request.auth.uid == uid || isOwner(roomId);
      }

      // 시간표: 본인 문서만 쓰기, 멤버는 읽기
      match /schedules/{uid} {
        allow read: if isMember(roomId);
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
